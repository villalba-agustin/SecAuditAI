# SecAuditAI - Environment Variables Configuration
APP_NAME=SecAuditAI
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8080

# Database
DATABASE_URL=sqlite:///./data/secauditai.db

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15

# Ollama Integration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
